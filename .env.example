# Lokalno: kopiraj u .env ili .env.local u ovom folderu (site), pa `npx vercel dev`.
# Vercel učitava .env, .env.local, .env.development.local (vidi Vercel docs).
# Produkcija: Vercel → Project → Settings → Environment Variables (isti nazivi).

# --- Claude (Anthropic) — ako je postavljen, koristi se PRVO ---
ANTHROPIC_API_KEY=sk-ant-api03-...

# Opciono (podrazumevano Haiku 4.5; ako API vrati grešku za model, stavi tačan ID iz Anthropic konzole)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI — samo rezerva ako NEMA Anthropic ključa ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
